# Скопируй в .env и заполни:  cp .env.example .env

# --- Telegram ---
# Токен от @BotFather и твой chat_id (узнать: @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Площадки ---
FL_ENABLED=true
PROFI_ENABLED=false          # включим на шаге 2
YOUDO_ENABLED=false          # сбор с Юду; отклик там пока не настроен

# --- Рейтинг заказа (0-10) ---
# Набрал столько — отклик уходит сразу. Ниже — заказ ждёт вечернего добора,
# когда видно, сколько лимитов и денег осталось за сутки. Правится из бота.
HOT_SCORE_MIN=7
EVENING_SWEEP_HOUR=21        # с какого часа по МСК разбираем отложенные
CLIENT_DEDUP_DAYS=14         # сколько дней помним, что этому заказчику уже писали

# --- Темп опроса ---
SCAN_INTERVAL=60             # сек между проходами по FL.ru
SCAN_JITTER=10               # случайная добавка, чтобы интервал не был идеально ровным
PROFI_SCAN_INTERVAL=30       # Profi.ru смотрим чаще: заказы разбирают за минуты

# --- Двухфазный отклик на Profi.ru ---
# true = сразу жмём «Откликнуться» (занимаем очередь), текст шлём следом
PROFI_TWO_PHASE=true
PROFI_MESSAGE_DELAY=120      # через сколько секунд отправить текст

# --- Двухфазный отклик на FL.ru ---
# На FL клиент видит текст отклика сразу в списке, поэтому первой фазой уходит
# не пустышка, а начало захода + срок и стоимость. Остальное — в чат.
FL_TWO_PHASE=true
FL_MESSAGE_DELAY=120
FL_OPENER_CHARS=220

# --- ЗАЩИТА БАЛАНСА PROFI.RU (отклик там платный) ---
# Всё, что ниже, правится кнопками в боте: значение из базы перебивает .env,
# а кнопка «вернуть значение из .env» откатывает обратно сюда.
PROFI_MAX_BID_PRICE=800      # дороже — не откликаемся вообще
PROFI_MAX_BID_PCT=2          # и не больше этой доли от бюджета заказа
PROFI_DAILY_BUDGET=1000      # потолок трат в сутки, ₽
PROFI_MIN_BALANCE=0          # неснижаемый остаток; 0 — тратим до нуля

# --- Лимиты откликов в сутки ---
FL_DAILY_BIDS=30
PROFI_DAILY_BIDS=15

# --- Тексты откликов (регламент лежит в knowledge/) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
VERDICT_ASK_ACTION=notify   # что делать с вердиктом модели «уточнить»: notify | skip

# --- Прокси (мобильный LTE) ---
# Вставь строку доступа как есть из кабинета: host:port:логин:пароль
# Либо в виде http://логин:пароль@host:port. Только HTTP(S), socks5 Chromium не потянет.
PROXY_URL=
PROXY_FOR_BROWSER=true       # авторизованные действия — через прокси
PROXY_FOR_FEED=false         # открытую RSS FL.ru тянем напрямую, не жжём трафик прокси

# --- Браузер (нужен для отклика и для Profi.ru) ---
BROWSER_HEADLESS=false       # на Mac оставь false; на VPS — Xvfb
BROWSER_TIMEOUT=30

# --- Глобальный стоп-кран ---
# true = только собираем и уведомляем, откликов НЕ шлём. Снимем на шаге 4.
DRY_RUN=true

# --- Прочее (обычно менять не нужно) ---
DB_PATH=/Users/serezastarkov/PyCharmMiscProject/freelance-bid/data/fbid.db
PROFILES_DIR=/Users/serezastarkov/PyCharmMiscProject/freelance-bid/profiles
