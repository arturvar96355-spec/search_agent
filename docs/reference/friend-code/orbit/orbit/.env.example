# --- Телеграм: один бот на все системы ---
# ВАЖНО: с этим токеном может работать только Orbit. Отдельных ботов систем
# («fbid bot», «parser bot») запускать больше не нужно — Orbit их заменяет.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Тексты писем ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Почта для рассылки ---
# Пока пусто: письма готовятся и копятся в очереди, но отправить их нечем.
# Нужен ПАРОЛЬ ПРИЛОЖЕНИЯ ящика (не основной пароль от почты).
# Яндекс: id.yandex.ru -> Безопасность -> Пароли приложений -> Почта.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=partnership@uniqore.ru
SMTP_PASSWORD=
SMTP_FROM_NAME=UniqOre

# --- Пределы рассылки ---
DAILY_LIMIT_PARTNERS=20
DAILY_LIMIT_CLIENTS=20
# Автоотправка. false = письма ждут кнопки «Отправить».
AUTOSEND=false

# --- Где лежат системы (обычно менять не надо) ---
# BIDS_PATH=/Users/serezastarkov/PyCharmMiscProject/freelance-bid
# LEADS_PATH=/Users/serezastarkov/PyCharmMiscProject/leadgen
LOG_FILE=data/orbit.log