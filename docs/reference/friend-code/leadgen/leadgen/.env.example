# Скопируй в .env и заполни. Реальный .env в git не коммитим (см. .gitignore).

# --- Прокси для браузерного добора (на VPS обязателен: датацентр-IP банит 2ГИС) ---
# ГОТОВЫЙ канал владельца — свой покупать НЕ надо, строка уже вписана ниже.
# Проверить после установки: parser proxy-check (должен показать российский мобильный IP).
# Для Chromium — ТОЛЬКО HTTP (socks5 с логином не работает).
# Несколько каналов через запятую = пул с ротацией при сбоях.
#
# ⚠️ Это рабочий платный доступ владельца. Не публиковать, не коммитить в открытый
#    репозиторий, не пересылать посторонним. При утечке — сменить пароль канала
#    в кабинете ltespace.net и обновить строку здесь и на сервере.
PROXY_URL=http://vz4dkbu3:n14e39wh@p10101.ltespace.net:10101

# --- API-ключи: заводишь СВОИ, все бесплатные (никогда не хардкодим и не логируем) ---
# DGIS_API_KEY  — platform.2gis.ru, демо 1000 запросов/мес. НЕ обязателен: без него
#                 поиск идёт браузером (см. BROWSER_SEARCH.md), только медленнее.
DGIS_API_KEY=
YANDEX_API_KEY=
# DADATA_API_KEY/SECRET — dadata.ru, бесплатный тариф «Подсказки». Дают ИНН и ФИО
#                 руководителя. Без них лиды придут без ИНН, но поиск работает.
DADATA_API_KEY=
DADATA_SECRET=

# --- Google Sheets: путь к JSON сервисного аккаунта ---
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Telegram-бот для доставки лидов: заводишь СВОЙ ---
# Создай нового бота у @BotFather (2 минуты) и вставь его токен — БЕЗ НЕГО БОТ НЕ СТАРТУЕТ.
# chat_id — свой (узнать у @userinfobot) или @канал, куда добавлен бот.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Кто может УПРАВЛЯТЬ ботом (запускать поиск). Числовые id через запятую.
# Пусто И TELEGRAM_CHAT_ID числовой  -> доступ только у владельца.
# Пусто И TELEGRAM_CHAT_ID = @канал  -> allowlist ПУСТ и бот открыт ЛЮБОМУ (в @канал числа нет).
# Поэтому на VPS задавай явно — свой id узнать: parser tg-chat-id
ALLOWED_CHAT_IDS=

# --- Email-рассылка по партнёрам (parser outreach; инструкция — EMAIL_OUTREACH.md) ---
# Без этих полей команда работает только в dry-run (показывает письма, не шлёт).
# ПЕРЕД первым --send: SPF/DKIM/DMARC на домене + прогрев ящика (EMAIL_OUTREACH.md, раздел 2).
# ВАЖНО: у пустых переменных комментарий НЕ пишем в той же строке — dotenv прочтёт его
# как значение, и doctor соврёт «SMTP настроен».
# SMTP_HOST: напр. smtp.yandex.ru (Яндекс 360) или smtp.mail.ru
SMTP_HOST=
# SMTP_PORT: 465 = SSL (обычный случай), 587 = STARTTLS
SMTP_PORT=465
# SMTP_USER: полный email отправителя, напр. partner@uniqore.ru
SMTP_USER=
# SMTP_PASSWORD: ПАРОЛЬ ПРИЛОЖЕНИЯ (не основной пароль аккаунта!)
SMTP_PASSWORD=
# SMTP_FROM_NAME: имя в поле «От кого»
SMTP_FROM_NAME=Менеджер Uniqore
# OUTREACH_DAILY_LIMIT: темп из брифа — 10 писем в день
OUTREACH_DAILY_LIMIT=10

# --- Логи (VPS) ---
# Пусто = только stderr/journald. Задай путь для файла с ротацией (20 МБ × 7 дней, zip).
LOG_FILE=
LOG_ROTATION_MB=20
LOG_RETENTION_DAYS=7

# --- Источник клиентского поиска (бот и коллектор) ---
# auto    — 2ГИС API, пока ключ жив; исчерпан/не задан → браузерный поиск (BROWSER_SEARCH.md)
# 2gis    — только API (при исчерпанном ключе поиск вернёт ноль)
# browser — всегда браузер: ключ не нужен, лимитов нет, но медленно и нужен прокси
SEARCH_SOURCE=auto

# --- Свежесть отзывов ---
# Жалобы учитываем только из отзывов этого года и новее (старьё неактуально).
REVIEWS_MIN_YEAR=2023

# Второй источник отзывов — Яндекс.Карты. Экспериментально: удваивает время на карточку,
# требует хорошего прокси. Включать (true), когда прокси стабильный.
USE_YANDEX_REVIEWS=false

# --- Фоновый сбор базы ---
COLLECT_TARGET=100        # до скольких лидов копить, потом стоп
COLLECT_DELAY=25.0        # кулдаун между пачками, сек (бережно=25, быстро=3)
COLLECT_PER_QUERY=5       # мест за пачку (бережно=5, быстро=20)

# --- Лимиты и rate limiting ---
MAX_RESULTS=200
PAGE_SIZE=10
REQUEST_DELAY=1.0
MAX_RETRIES=3
REQUEST_TIMEOUT=20.0
# Таймаут загрузки страницы в браузере (сек). Больше API: 2ГИС тяжёлый + прокси медленный.
BROWSER_TIMEOUT=60.0

# --- Пути ---
# OUTPUT_DIR: НЕ задавай относительным путём. Дефолт — <корень проекта>/output (абсолютный),
# и он верен всегда. Относительный «output» считается от текущего каталога: запустишь бота
# из /root — рядом создастся ПУСТАЯ база, а накопленные лиды «исчезнут».
# Нужен свой путь — пиши абсолютный, напр. OUTPUT_DIR=/var/lib/leadgen/output
# OUTPUT_DIR=
