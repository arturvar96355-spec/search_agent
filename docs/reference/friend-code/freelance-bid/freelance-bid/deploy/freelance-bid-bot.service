[Unit]
Description=freelance-bid: телеграм-бот управления
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/freelance-bid
EnvironmentFile=/opt/freelance-bid/.env

# Виртуальный экран нужен и здесь: кнопка «Проверить ответы» открывает браузер
# так же, как основной цикл. Без Xvfb она молча падала бы на сервере без экрана.
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1440x900x24" \
    /opt/freelance-bid/.venv/bin/python -m fbid.cli bot

Restart=always
RestartSec=30

# Памяти нужно как основному циклу: Chromium поднимается по кнопке проверки.
# Профиль браузера у процессов общий, но захватывается по очереди (fbid/browser.py),
# поэтому два Chromium одновременно не стартуют.
MemoryMax=1400M

# Логи уходят в journald: journalctl -u freelance-bid-bot -f
StandardOutput=journal
StandardError=journal

# Профили браузера — это живые доступы к аккаунтам бирж.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
